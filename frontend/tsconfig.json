{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2015", "dom"],
    "types": [],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": ".build"
  },
  "include": ["src/**/*.ts"]
}
