<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tap.web.pos.mapper.ProductMapper">

    <sql id="productSearchConditions">
        <where>
            <if test="name != null">
                AND strpos(lower(name), lower(#{name})) &gt; 0
            </if>
            <if test="minPrice != null">
                AND price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>
        </where>
    </sql>

    <select id="searchProducts" resultType="com.tap.web.pos.model.Product">
        SELECT id, name, price, quantity
        FROM products
        <include refid="productSearchConditions" />
        ORDER BY id ASC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countProducts" resultType="long">
        SELECT count(*) FROM products
        <include refid="productSearchConditions" />
    </select>

    <select id="getProducts" resultType="com.tap.web.pos.model.Product">
        SELECT id, name, price, quantity
        FROM products
        ORDER BY id ASC
    </select>

    <insert id="createProduct" parameterType="com.tap.web.pos.model.Product" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
      INSERT INTO products (name, price, quantity)
      VALUES (#{name}, #{price}, #{quantity})
    </insert>

    <update id="updateProduct" parameterType="com.tap.web.pos.model.Product">
      UPDATE products
      SET name = #{name},
          price = #{price},
          quantity = #{quantity}
      WHERE id = #{id}
    </update>

    <delete id="deleteProduct" parameterType="int">
        DELETE FROM products
        WHERE id = #{id}
    </delete>
</mapper>